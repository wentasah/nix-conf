#!/usr/bin/env bash
# Steps of the CI pipeline (.gitlab-ci.yml), run by opal in a snapshot
# of the repository. First, my nixpkgs fork is updated:
#
#   nixpkgs-update: merge topic branches onto new nixos-unstable (in
#                   ~/nix/nixpkgs) and push the result to wentasah/ci
#                   (+ record it in wentasah/history)
#
# Then, two independent chains run:
#
#   stable:   update stable inputs   -> build stable checks   -> push to origin/stable
#   unstable: update all inputs      -> build unstable checks -> push to origin/unstable
#
# Usage:
#   nix-ci nixpkgs-update
#   nix-ci update stable|unstable   # writes ci-artifacts/{flake.lock,ci.env}
#   nix-ci build CHECK              # e.g. steelpick (from checks.<system>.steelpick)
#   nix-ci push stable|unstable

set -euo pipefail
set -x

NIXPKGS_DIR=$HOME/nix/nixpkgs  # hardcoded in nix-conf merge
STABLE_INPUTS=(nixpkgs-stable home-manager-stable)
ART=ci-artifacts

export GIT_AUTHOR_NAME=nix-conf GIT_AUTHOR_EMAIL=nix-conf@localhost
export GIT_COMMITTER_NAME=nix-conf GIT_COMMITTER_EMAIL=nix-conf@localhost

die() { echo "error: $*" >&2; exit 1; }

assert_valid_branch() {
    case "$1" in
        stable|unstable) ;;
        *) die "unknown branch '$1'" ;;
    esac
}

# Fetch origin/$1 if it exists; print its commit (empty if it doesn't)
fetch_branch() {
    if git fetch --quiet origin "+refs/heads/$1:refs/remotes/origin/$1" 2>/dev/null; then
        git rev-parse "refs/remotes/origin/$1"
    fi
}

cmd_nixpkgs_update() {
    local nix_conf old
    nix_conf=$(realpath bin/nix-conf)
    cd "$NIXPKGS_DIR"
    git diff-index --quiet HEAD -- || die "$NIXPKGS_DIR is dirty"
    git fetch --quiet origin nixos-unstable
    git fetch --quiet wentasah
    git update-ref refs/heads/nixos-unstable origin/nixos-unstable
    "$nix_conf" merge

    # Publish the result as in publish_ci_update() in nix-conf
    if git diff --quiet wentasah/ci; then
        echo "wentasah/ci is up to date"
        return
    fi
    git push --force wentasah HEAD:ci
    local old_commit new_commit
    old_commit=$(git rev-parse history)
    new_commit=$(git commit-tree -p "$old_commit" -p HEAD "HEAD^{tree}" -m "update history branch")
    git update-ref refs/heads/history "$new_commit" "$old_commit"
    git push wentasah history
}

cmd_update() {
    local branch=$1 inputs
    assert_valid_branch "$branch"
    # Build exactly what is committed (opal snapshots include dirty changes)
    git reset --quiet --hard HEAD

    if [[ $branch == stable ]]; then
        inputs=("${STABLE_INPUTS[@]}")
        echo "Updating inputs: ${inputs[*]}"
    else
        inputs=()  # all inputs
        echo "Updating all inputs"
    fi
    nix flake update "${inputs[@]}"

    # Something to do only if the result differs from what is already
    # on the branch (updated inputs or new commits on main)
    local old new updated=1
    old=$(fetch_branch "$branch")
    git add flake.lock
    new=$(git write-tree)
    if [[ -n $old && $(git rev-parse "$old^{tree}") == "$new" ]]; then
        echo "origin/$branch is up to date - nothing to do"
        updated=0
    fi

    mkdir -p "$ART"
    cp flake.lock "$ART/flake.lock"
    echo "NIX_CI_UPDATED=$updated" > "$ART/ci.env"
}

use_updated_lock() {
    [[ -f $ART/flake.lock ]] || die "$ART/flake.lock missing (artifact of the update job)"
    cp --remove-destination "$ART/flake.lock" flake.lock
}

cmd_build() {
    local name=$1 attr out
    if [[ ${NIX_CI_UPDATED:-} != 1 ]]; then
        echo "Nothing updated - skipping build of $name"
        return
    fi
    use_updated_lock
    # Find the system of the check, e.g. resox -> x86_64-linux.resox
    attr=$(nix eval --json .#checks --apply 'builtins.mapAttrs (_: builtins.attrNames)' |
               jq -r --arg n "$name" 'to_entries[] | select(.value | index($n)) | "\(.key).\($n)"')
    [[ -n $attr ]] || die "check '$name' not found"
    [[ $attr != *$'\n'* ]] || die "check '$name' exists for multiple systems: "$attr
    out=$(nix build -L --no-link --print-out-paths ".#checks.$attr")
    if [[ -n ${ATTIC_CACHE:-} ]]; then
        attic push "$ATTIC_CACHE" $out
    fi
}

cmd_push() {
    local branch=$1 old commit
    assert_valid_branch "$branch"
    if [[ ${NIX_CI_UPDATED:-} != 1 ]]; then
        echo "Nothing updated - not pushing $branch"
        return
    fi
    git reset --quiet --hard HEAD
    local main subject
    main=$(git rev-parse HEAD)
    subject=$(git log -1 --format=%s "$main")

    # Keep the branch history: merge main into $branch, preferring
    # main's side on conflicts
    old=$(fetch_branch "$branch")
    if [[ -n $old ]]; then
        git checkout --quiet --detach "$old"
        git merge --quiet --no-edit -Xtheirs -m "Merge main: $subject" "$main"
    fi

    use_updated_lock
    if ! git diff --quiet HEAD -- flake.lock; then
        git commit --quiet -m "flake.lock: Update $branch inputs ($subject)" -- flake.lock
    fi
    commit=$(git rev-parse HEAD)

    git push origin "$commit:refs/heads/$branch"
}

case "${1:-}" in
    nixpkgs-update) cmd_nixpkgs_update; exit ;;
esac
[[ $# -eq 2 ]] || die "usage: $0 nixpkgs-update | update|build|push ARG"
case "$1" in
    update) cmd_update "$2" ;;
    build)  cmd_build "$2" ;;
    push)   cmd_push "$2" ;;
    *) die "unknown command '$1'" ;;
esac
